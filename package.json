{
  "name": "visualforge",
  "version": "0.1.0-alpha.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @visualforge/gallery",
    "build": "npm run build -w @visualforge/react && npm run build -w @visualforge/gallery",
    "test": "vitest run",
    "typecheck": "tsc -p apps/gallery/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "jsdom": "26.1.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
